<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.PhotoPreviewController">
   <children>
      <VBox alignment="TOP_CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Preview of the captured photo -->
            <ImageView fx:id="imgPreview" fitHeight="340.0" fitWidth="580.0" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </ImageView>
            <Label text="Despues de Guardar Foto se tiene que seleccionar en Registro de Clientess" />

            <!-- Two-button row -->
            <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="55.0" prefWidth="580.0" spacing="15.0">
               <children>
                  <MFXButton fx:id="btnRetake" onAction="#onActionBtnRetake" prefHeight="38.0" prefWidth="160.0" text="Tomar de nuevo" />
                  <MFXButton fx:id="btnSave" onAction="#onActionBtnSave" prefHeight="38.0" prefWidth="160.0" text="Guardar" />
               </children>
               <VBox.margin>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
