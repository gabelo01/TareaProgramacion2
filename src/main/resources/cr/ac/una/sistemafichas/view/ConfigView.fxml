<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="375.0" prefWidth="664.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.ConfigController">
   <children>
      <VBox alignment="CENTER" prefHeight="375.0" prefWidth="664.0" spacing="20.0">
         <children>
         
                <Label styleClass="title" text="Configuración general" />
         
                   <HBox alignment="CENTER_LEFT" spacing="10">
                 <Label minWidth="150" styleClass="label-field" text="Nombre empresa:" />
                 <TextField fx:id="txtCompanyName" styleClass="input-field" HBox.hgrow="ALWAYS" />
             </HBox>
         
                   <HBox alignment="CENTER_LEFT" spacing="10">
                 <Label minWidth="150" styleClass="label-field" text="PIN administrador:" />
                 <PasswordField fx:id="txtPin" styleClass="input-field" HBox.hgrow="ALWAYS" />
             </HBox>
         
                         <HBox alignment="CENTER_LEFT" spacing="10">
                 <Label minWidth="150" styleClass="label-field" text="Logo (ruta):" />
                 <TextField fx:id="txtLogo" styleClass="input-field" HBox.hgrow="ALWAYS" />
                 <Button fx:id="btnSelectLogo" styleClass="btn-secondary" text="Seleccionar" />
             </HBox>
         
                               <Label fx:id="lblMensaje" styleClass="label-success" visible="false" />
         
                <HBox alignment="CENTER" spacing="10">
                 <Button fx:id="btnGuardar" styleClass="btn-primary" text="Guardar" />
                 <Button fx:id="btnVolver" styleClass="btn-secondary" text="Volver" />
             </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
