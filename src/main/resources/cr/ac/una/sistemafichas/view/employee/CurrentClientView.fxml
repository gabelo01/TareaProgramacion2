<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.employee.CurrentClientController">

    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding><Insets bottom="20" left="40" right="40" top="20" /></padding>

            <ImageView fx:id="imgClient" fitHeight="140" fitWidth="140" pickOnBounds="true" preserveRatio="true" />
         <Separator prefWidth="200.0" />
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <children>
               <Label text="Tipo:">
                  <HBox.margin>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </HBox.margin>
               </Label>
      
                  <Label fx:id="lblType" text="tipo" />
            </children>
         </HBox>
         <Separator prefWidth="200.0" />
         <VBox alignment="CENTER" prefHeight="98.0" prefWidth="388.0" spacing="10.0">
            <children>
      
                  <HBox alignment="CENTER_LEFT" spacing="10">
                      <Label text="Nombre:" />
                      <Label fx:id="lblName" text="nombre" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                      <Label text="Cédula:" />
                      <Label fx:id="lblID" text="id" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                      <Label text="Tramite:" />
                      <Label fx:id="lblProcedure" text="tramite" />
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                      <Label text="Ticket:" />
                      <Label fx:id="lblTicketNumber" text="ticket" />
                  </HBox>
            </children>
         </VBox>
         <Separator prefWidth="200.0" />
        </VBox>
    </center>
   <bottom>
         <MFXButton fx:id="btnExit" onAction="#onActionBtnBack" prefHeight="33.0" prefWidth="91.0" text="SALIR" BorderPane.alignment="CENTER_RIGHT">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </MFXButton>
   </bottom>
   <top>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="500.0" BorderPane.alignment="CENTER">
         <children>
               <Label text="Información del Cliente" />
         </children>
      </HBox>
   </top>

</BorderPane>
