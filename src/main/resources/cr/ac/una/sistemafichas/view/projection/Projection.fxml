<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="575.0" prefWidth="934.0" stylesheets="@../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.projection.ProjectionController">

    <top>
        <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="50.0" prefWidth="934.0" styleClass="color-fondo-oscuro" BorderPane.alignment="CENTER_LEFT">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <VBox alignment="CENTER" spacing="4" styleClass="jfx-label-projection">
                <Label fx:id="lblDate" text="Monday 01 January, 2026" />
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" spacing="5.0">
               <children>
                  <Label text="Hora:" />
                      <Label fx:id="lblTime" text="00:00:00" />
               </children>
            </HBox>
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="20" styleClass="color-fondo-claro">
            <padding><Insets bottom="20" left="30" right="30" top="20" /></padding>

            <VBox alignment="CENTER" prefHeight="478.0" prefWidth="547.0" spacing="15" styleClass="color-fondo-claro" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="10">
                    <Label fx:id="lblPriorityBadge" styleClass="jfx-label-text-projection" text="PREFERENTIAL" visible="false" />
                    <Pane HBox.hgrow="ALWAYS" />
                </HBox>
                <Label styleClass="jfx-label-text-projection" text="TICKET" />
            <VBox alignment="CENTER" prefHeight="269.0" prefWidth="489.0" styleClass="color-fondo-oscuro">
               <children>
                      <Label fx:id="lblCurrentTicket" prefHeight="205.0" prefWidth="104.0" styleClass="jfx-label-ticket-projection" text="#">
                     <font>
                        <Font size="52.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
                <Label fx:id="lblCurrentStation" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" prefHeight="18.0" prefWidth="50.0" styleClass="jfx-label-text-projection" text="Estación" />
            </VBox>
         <Separator orientation="VERTICAL" prefHeight="200.0" />

            <VBox alignment="TOP_CENTER" prefHeight="506.0" prefWidth="230.0" spacing="8" styleClass="jfx-label-text-projection" HBox.hgrow="SOMETIMES">
                <Label fx:id="lblLastCalls" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" styleClass="jfx-label" text="Ultimos Cuatro Llamados" />

                <GridPane alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="jfx-label">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40.0" prefWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="  #" GridPane.columnIndex="0" />
                    <Label text="TICKET" GridPane.columnIndex="1" />
                    <Label text="Estacion Asignada" GridPane.columnIndex="2" />
                    <padding><Insets bottom="6" left="10" right="10" top="6" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
               <VBox.margin>
                  <Insets left="4.0" />
               </VBox.margin>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40.0" prefWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label styleClass="jfx-label" text="1" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket1" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation1" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label styleClass="jfx-label" text="2" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket2" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation2" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308" prefHeight="34.0" prefWidth="318.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label styleClass="jfx-label" text="3" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket3" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation3" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label styleClass="jfx-label" text="4" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket4" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation4" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
               <ImageView fx:id="imgLogo" fitHeight="159.0" fitWidth="266.0" pickOnBounds="true" preserveRatio="true">
               <viewport>
                  <Rectangle2D />
               </viewport>
            </ImageView>
               <Label fx:id="lblCompanyName" styleClass="jfx-label" text="Company Name" />
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <AnchorPane maxWidth="1.7976931348623157E308" prefHeight="54.0" prefWidth="934.0" styleClass="color-fondo-oscuro">
            <Label fx:id="lblNotice" styleClass="jfx-label-projection" text="Bienvenido...Informacion tipo carrusel" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="15" />
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
        </AnchorPane>
    </bottom>

</BorderPane>
