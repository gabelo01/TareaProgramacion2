<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="600.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.projection.ProjectionController">

    <top>
        <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER_LEFT">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <ImageView fx:id="imgLogo" fitHeight="70" fitWidth="70" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="lblCompanyName" text="Company Name">
                <HBox.margin><Insets left="15" /></HBox.margin>
            </Label>
            <Pane HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="4">
                <Label fx:id="lblDate" text="Monday 01 January, 2026" />
                <Label fx:id="lblTime" text="00:00:00" />
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="20">
            <padding><Insets bottom="20" left="30" right="30" top="20" /></padding>

            <VBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="10">
                    <Label fx:id="lblPriorityBadge" text="PREFERENTIAL" visible="false" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblNewBadge" text="NEW" visible="false" />
                </HBox>
                <Label text="TICKET" />
                <Label fx:id="lblCurrentTicket" text="---" />
                <Label fx:id="lblCurrentStation" text="" />
            </VBox>

            <VBox alignment="TOP_CENTER" prefWidth="340" spacing="8">
                <Label maxWidth="1.7976931348623157E308" text="LAST CALLS" />

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="#" GridPane.columnIndex="0" />
                    <Label text="TICKET" GridPane.columnIndex="1" />
                    <Label text="STATION" GridPane.columnIndex="2" />
                    <padding><Insets bottom="6" left="10" right="10" top="6" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="1" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket1" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation1" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="2" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket2" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation2" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="3" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket3" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation3" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints minWidth="40" prefWidth="40" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="4" GridPane.columnIndex="0" />
                    <Label fx:id="lblTicket4" text="---" GridPane.columnIndex="1" />
                    <Label fx:id="lblStation4" text="---" GridPane.columnIndex="2" />
                    <padding><Insets bottom="8" left="10" right="10" top="8" /></padding>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <AnchorPane maxWidth="1.7976931348623157E308" prefHeight="60">
            <Label fx:id="lblNotice" text="Welcome...Information" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="15" />
        </AnchorPane>
    </bottom>

</BorderPane>
