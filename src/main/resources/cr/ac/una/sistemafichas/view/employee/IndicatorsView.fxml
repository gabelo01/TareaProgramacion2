<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.employee.IndicatorsController">

    <center>
        <VBox spacing="10">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <Label fx:id="lblTotal" text="Total esperando: 0" />
            <ListView fx:id="listProcedures" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
   <bottom>
         <MFXButton onAction="#onActionBtnBack" prefHeight="34.0" prefWidth="84.0" text="Salir" BorderPane.alignment="CENTER_RIGHT">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </MFXButton>
   </bottom>
   <top>
      <VBox alignment="TOP_CENTER" prefHeight="47.0" prefWidth="500.0" BorderPane.alignment="CENTER">
         <children>
               <Label text="Indicadores " />
            <Label layoutX="10.0" layoutY="10.0" text="Esperando por Tramite">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Label>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
   </top>

</BorderPane>
