<?xml version="1.0" encoding="UTF-8"?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.sistemafichas.controller.BranchesController">
    <children>
        <VBox prefHeight="600.0" prefWidth="800.0" spacing="10.0">

            <!-- Encabezado -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0">
                <children>
                    <ImageView fx:id="imgLogo" fitHeight="50.0" fitWidth="60.0"
                               preserveRatio="true" pickOnBounds="true"/>
                    <Label fx:id="lbCompany" text="Nombre de la empresa">
                        <padding><Insets left="10.0"/></padding>
                    </Label>
                </children>
                <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
            </HBox>

            <Label text="SUCURSALES Y ESTACIONES" style="-fx-font-size: 16px; -fx-font-weight: bold;">
                <padding><Insets left="10.0"/></padding>
            </Label>

            <!-- Contenido principal: izquierda sucursales, derecha estaciones -->
            <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                <padding><Insets left="10.0" right="10.0"/></padding>

                <!-- Panel izquierdo: Sucursales -->
                <VBox spacing="8.0" prefWidth="360.0">
                    <Label text="Sucursales" style="-fx-font-weight: bold;"/>

                    <HBox spacing="8.0">
                        <MFXTextField fx:id="txtBranchName" floatingText="Nombre sucursal"
                                      HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <MFXTextField fx:id="txtBranchDir" floatingText="Dirección"/>
                    <MFXTextField fx:id="txtNotice" floatingText="Texto de avisos (proyección)"/>

                    <HBox spacing="8.0">
                        <MFXButton fx:id="btnAddBranch" text="Agregar" onAction="#btnAddBranch"
                                   prefWidth="110.0"/>
                        <MFXButton fx:id="btnUpdateBranch" text="Actualizar" onAction="#btnUpdateBranch"
                                   prefWidth="110.0"/>
                        <MFXButton fx:id="btnDeleteBranch" text="Eliminar" onAction="#btnDeleteBranch"
                                   prefWidth="110.0"/>
                    </HBox>

                    <Label text="Lista de sucursales" style="-fx-font-size: 12px;"/>
                    <ListView fx:id="listBranches" VBox.vgrow="ALWAYS" prefHeight="200.0"/>
                </VBox>

                <!-- Panel derecho: Estaciones -->
                <VBox spacing="8.0" prefWidth="380.0">
                    <Label text="Estaciones de la sucursal seleccionada"
                           style="-fx-font-weight: bold;"/>

                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <MFXTextField fx:id="txtStationName" floatingText="Nombre estación"
                                      HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="chkPreferential" text="Preferencial"/>
                    </HBox>

                    <MFXButton fx:id="btnAddStation" text="Agregar estación"
                               onAction="#btnAddStation" prefWidth="160.0"/>

                    <Label text="Estaciones:" style="-fx-font-size: 12px;"/>
                    <ListView fx:id="listStations" prefHeight="120.0"/>

                    <!-- Drag and drop de trámites -->
                    <Label text="Trámites disponibles (arrastrá a la estación):"
                           style="-fx-font-size: 12px;"/>
                    <ListView fx:id="listAvailableProcedures" prefHeight="100.0"/>

                    <Label text="Trámites asignados a la estación:"
                           style="-fx-font-size: 12px;"/>
                    <ListView fx:id="listStationProcedures" prefHeight="100.0"/>

                    <MFXButton fx:id="btnRemoveProcedure" text="Quitar trámite seleccionado"
                               onAction="#btnRemoveProcedure" prefWidth="220.0"/>
                </VBox>
            </HBox>

            <!-- Botón volver -->
            <HBox alignment="BOTTOM_RIGHT" prefHeight="40.0">
                <padding><Insets bottom="10.0" right="10.0"/></padding>
                <MFXButton fx:id="btnVolver" text="Volver" onAction="#btnVolver"
                           prefWidth="115.0"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>