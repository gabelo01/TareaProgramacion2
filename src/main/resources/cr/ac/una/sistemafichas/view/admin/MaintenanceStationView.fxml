<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="600.0" minWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.admin.MaintenanceStationController">
   <children>
      <Label alignment="CENTER" text="Mantenimiento de Estaciones" VBox.vgrow="ALWAYS">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <HBox spacing="20" VBox.vgrow="ALWAYS">
         <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
            <children>
               <Label text="Lista de Estaciones" VBox.vgrow="ALWAYS" />
               <ListView fx:id="tblListStations" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            </children>
         </VBox>
      
      
          <VBox spacing="10" HBox.hgrow="ALWAYS">
      
              <TextField fx:id="txtNombre" promptText="Nombre estación" VBox.vgrow="ALWAYS" />
              <CheckBox fx:id="chkPreferencial" text="Preferencial" VBox.vgrow="ALWAYS" />
              <HBox spacing="15" VBox.vgrow="ALWAYS">
               <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                  <children>
                     <Label text="Tramites Disponibles" VBox.vgrow="ALWAYS" />
                        <ListView fx:id="tblListAvailableProcedures" prefWidth="150" VBox.vgrow="ALWAYS" />
                  </children>
               </VBox>
               <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                  <children>
                     <Label text="Tramites Asignados" VBox.vgrow="ALWAYS" />
                        <ListView fx:id="tblListAsignedProcedures" prefWidth="150" VBox.vgrow="ALWAYS" />
                  </children>
               </VBox>
              </HBox>
      
              <HBox spacing="10">
                  <Button onAction="#onActionNuevo" text="Nuevo" HBox.hgrow="ALWAYS" />
                  <Button onAction="#onActionGuardar" text="Guardar" HBox.hgrow="ALWAYS" />
                  <Button onAction="#onActionEliminar" text="Eliminar" HBox.hgrow="ALWAYS" />
              </HBox>
            <HBox.margin>
               <Insets bottom="10.0" top="10.0" />
            </HBox.margin>
      
          </VBox>
      
      </HBox>
   </children>
</VBox>
