<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXCheckbox?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
            minHeight="550.0" minWidth="680.0" prefHeight="580.0" prefWidth="750.0"
            stylesheets="@../Style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.sistemafichas.controller.admin.MaintenanceClientController">
   <children>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0"
            styleClass="vBox"
            AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0"
            AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <!-- Main HBox: list on left, form on right -->
            <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                  spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- LEFT: filter + list -->
                  <VBox maxHeight="1.7976931348623157E308" spacing="8.0"
                        styleClass="vBox" HBox.hgrow="SOMETIMES" minWidth="240.0" maxWidth="280.0">
                     <children>
                        <Label styleClass="jfx-label" text="Clientes registrados"/>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label minWidth="60.0" styleClass="jfx-label-text" text="Nombre:"/>
                              <TextField fx:id="tfC_Name" maxWidth="1.7976931348623157E308"
                                         promptText="Buscar por nombre..." HBox.hgrow="ALWAYS"/>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label minWidth="52.0" styleClass="jfx-label-text" text="Cédula:"/>
                              <TextField fx:id="tfC_Id" maxWidth="1.7976931348623157E308"
                                         promptText="Buscar por cédula..." HBox.hgrow="ALWAYS"/>
                           </children>
                        </HBox>
                        <ListView fx:id="listClients" maxHeight="1.7976931348623157E308"
                                  maxWidth="1.7976931348623157E308" styleClass="list-cell"
                                  VBox.vgrow="ALWAYS"/>
                     </children>
                     <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>
                  </VBox>

                  <!-- RIGHT: form -->
                  <VBox maxHeight="1.7976931348623157E308" spacing="10.0"
                        styleClass="vBox" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="jfx-label" text="Datos del cliente"/>

                        <!-- Photo -->
                        <VBox alignment="TOP_CENTER" spacing="8.0">
                           <children>
                              <ImageView fx:id="imgClient" fitHeight="120.0" fitWidth="150.0"
                                         pickOnBounds="true" preserveRatio="true"/>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#OnActionBtnAddPhoto"
                                            styleClass="jfx-btn-nuevo" text="Seleccionar Foto"
                                            HBox.hgrow="ALWAYS" maxHeight="1.7976931348623157E308">
                                       <graphic><ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true"/></graphic>
                                    </Button>
                                    <Button mnemonicParsing="false" onAction="#OnActionBtnOpenCamera"
                                            styleClass="jfx-btn-photo" text="Tomar foto"
                                            HBox.hgrow="ALWAYS" maxHeight="1.7976931348623157E308">
                                       <graphic><ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true"/></graphic>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Fields -->
                        <HBox spacing="10.0">
                           <children>
                              <MFXButton onAction="#onActionBtnNuevo" styleClass="jfx-btn-nuevo" text="Nuevo">
                                 <graphic><ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true"/></graphic>
                              </MFXButton>
                              <MFXButton onAction="#OnActionBtnScanID" text="Scanear ID"/>
                              <MFXCheckbox fx:id="chkPreferencial" text="Preferencial"/>
                           </children>
                        </HBox>

                        <MFXTextField fx:id="txtClientName" floatMode="BORDER"
                                      floatingText="Nombre" maxWidth="1.7976931348623157E308"
                                      prefHeight="43.0"/>
                        <MFXTextField fx:id="txtClientId" floatMode="BORDER"
                                      floatingText="Cédula" maxWidth="1.7976931348623157E308"
                                      prefHeight="43.0"/>
                        <MFXTextField fx:id="txtClientAge" floatMode="BORDER"
                                      floatingText="Fecha nacimiento (año-mes-día)"
                                      maxWidth="1.7976931348623157E308" prefHeight="43.0"/>

                        <!-- Action buttons -->
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                           <children>
                              <MFXButton onAction="#OnActionBtnEditClient" styleClass="jfx-btn-edit" text="Guardar Cambio">
                                 <graphic><ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true"/></graphic>
                              </MFXButton>
                              <MFXButton onAction="#OnActionBtnAddClient" styleClass="jfx-btn-add" text="Agregar">
                                 <graphic><ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true"/></graphic>
                              </MFXButton>
                              <MFXButton onAction="#OnActionBtnDeleteClient" styleClass="jfx-btn-delete" text="Eliminar">
                                 <graphic><ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true"/></graphic>
                              </MFXButton>
                           </children>
                           <VBox.margin><Insets top="10.0"/></VBox.margin>
                        </HBox>
                     </children>
                     <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
      </VBox>
   </children>
</AnchorPane>
