<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="420.0" prefWidth="600.0" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.sistemafichas.controller.CameraController">
   <children>
      <VBox alignment="TOP_CENTER" styleClass="color-fondo-oscuro" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <StackPane styleClass="image-container" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <children>
                  <!-- Live camera preview -->
                  <ImageView fx:id="imgImageView" fitHeight="340.0" fitWidth="580.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </StackPane>

            <!-- Single button row -->
            <HBox alignment="CENTER" prefHeight="51.0" prefWidth="590.0" spacing="20.0" styleClass="color-fondo-claro" VBox.vgrow="NEVER">
               <children>
                  <MFXButton fx:id="btnTakePhoto" onAction="#onActionBtnTakePhoto" prefHeight="38.0" prefWidth="160.0" text="Tomar foto" />
                  <MFXButton fx:id="btnCancel" layoutX="220.0" layoutY="10.0" onAction="#onActionBtnCancel" prefHeight="38.0" prefWidth="160.0" styleClass="jfx-btn-exit" text="Cancelar / Salir">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic></MFXButton>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
